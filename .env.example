# ---------------------------------------------------------------------------
# FOCUSFORGE environment variables
# Copy this file to `.env` (never commit `.env`).
# ---------------------------------------------------------------------------

# Supabase project URL — Project Settings → API → Project URL
VITE_SUPABASE_URL=

# Supabase anon/public key — Project Settings → API → anon public
# This key is safe in the browser ONLY together with the RLS policies in
# supabase/migrations/0001_init.sql. Never paste a service_role key here.
VITE_SUPABASE_ANON_KEY=

# Optional: Vercel/Netlify build-time auth redirect base (not required)
# VITE_SITE_URL=

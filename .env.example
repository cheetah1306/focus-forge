# ---------------------------------------------------------------------------
# FOCUSFORGE environment variables
# Copy this file to `.env` (never commit `.env`).
# ---------------------------------------------------------------------------

# Supabase project URL — Project Settings → API → Project URL
VITE_SUPABASE_URL=

# Supabase publishable key (sb_publishable_…) or the legacy anon public JWT
# — Project Settings → API. Either is safe in the browser ONLY together with
# the RLS policies in supabase/migrations/0001_init.sql.
# Never paste a secret / service_role key here.
VITE_SUPABASE_ANON_KEY=

# Optional: Vercel/Netlify build-time auth redirect base (not required)
# VITE_SITE_URL=
